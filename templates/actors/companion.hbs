{{!log "companion" this}}
<section class="tab standard-form companion {{#if tabs.companion.active}} active{{/if}}" data-group="primary" data-tab="companion">
  <h5 class="form-header master">
    <a data-action="toggleSection">{{localize "CO.label.long.master"}}</a>
  </h5>
  <div class="form-group">
       {{#if hasMaster}}

            {{#if masterImg}}
            <div class="image-container">
                <img class="target-portrait" src="{{masterImg}}" data-tooltip="{{masterName}}" height="32" width="32" />
            </div>
           {{/if}}
                <span class="target-name">{{masterName}}</span>
                {{#if unlocked}}
                <a class="item-control" data-action="deleteMaster" data-tooltip={{localize "CO.ui.remove"}}><i class="fas fa-trash"></i></a>
                {{/if}}

        {{else}}
                <span class="target-name" data-tooltip="{{localize 'CO.ui.noMasterTooltip'}}">{{localize "CO.label.long.noMaster"}}</span>
        {{/if}}

  </div>
  <h5 class="form-header companion">
    <a data-action="toggleSection" data-tooltip="{{localize 'CO.ui.companionFormulaHint'}}">{{localize "CO.ui.companionInfos"}}</a>
  </h5>
  <div class="modifiers-container foldable">
     <div class="form-group companion-rank-group">
       <label>{{localize "CO.ui.companionRank"}}</label>
       <input class="companion-rank" type="number" name="system.companion.rank" value="{{system.companion.rank}}" min="0" step="1" data-dtype="Number" {{#unless unlocked}}readonly{{/unless}} />
     </div>
     {{#each system.companionFormulaErrors}}
       <p class="notification warning">{{this}}</p>
     {{/each}}
     <section class="half-panel">
            <section class="panel-left">
                {{#each system.abilities as |a id|}}
                    <div class="form-group">
                        <label style="text-align:center;">{{localize (concat "CO.abilities.short." id)}}</label>
                        <input type="text" name="system.abilities.{{id}}.formula" value="{{a.formula}}" data-dtype="String" {{#unless @root.unlocked}}readonly{{/unless}} />
                    </div>    
                {{/each}}   
               
                <div class="form-group">
                        <label style="text-align:center;">{{localize "CO.label.long.hp"}}</label>
                        <input type="text" name="system.attributes.hp.formula" value="{{system.attributes.hp.formula}}" data-dtype="String" {{#unless @root.unlocked}}readonly{{/unless}} />
                </div>
            </section>  
            <section class="panel-right">
            {{#each system.combat as |a id|}}
                <div class="form-group">
                    <label style="text-align:center;">{{localize (concat "CO.combat.short." id)}}</label>
                    <input type="text" name="system.combat.{{id}}.formula" value="{{a.formula}}" data-dtype="String" {{#unless @root.unlocked}}readonly{{/unless}} />
                </div>
            {{/each}}
            </section>
    </section> 
  </div>

</section>
